#!/usr/bin/env bash
set -euo pipefail

readonly PVESM='/usr/sbin/pvesm'
readonly INSTALL='/usr/bin/install'
readonly MKDIR='/bin/mkdir'
readonly RM='/bin/rm'
readonly MKTEMP='/usr/bin/mktemp'

usage() {
  printf 'usage: %s [--verify] --storage STORAGE --filename PREFIX-N-user-data.yml\n' "$0" >&2
}

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

storage_id=''
filename=''
verify='false'

while [[ $# -gt 0 ]]; do
  case $1 in
    --storage)
      storage_id=${2-}
      shift 2
      ;;
    --filename)
      filename=${2-}
      shift 2
      ;;
    --verify)
      verify='true'
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n ${storage_id} ]] || die 'storage is required'
[[ -n ${filename} ]] || die 'filename is required'
[[ ${storage_id} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die 'storage id must use conservative characters only'
[[ ${filename} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*-[0-9]+-user-data\.yml$ ]] || die 'filename must match PREFIX-N-user-data.yml with a conservative prefix'
[[ ${filename} != *'/'* ]] || die 'filename must not contain path separators'

if [[ ! -x ${PVESM} ]]; then
  die 'pvesm is required'
fi

resolve_target_path() {
  local resolved=''
  if resolved="$(${PVESM} path "${storage_id}:snippets/${filename}" 2>/dev/null)" && [[ -n ${resolved} ]]; then
    printf '%s\n' "${resolved}"
  else
    printf '/mnt/pve/%s/snippets/%s\n' "${storage_id}" "${filename}"
  fi
}

target_path="$(resolve_target_path)"
target_dir="$(dirname "${target_path}")"
storage_dir="$(dirname "${target_dir}")"

if [[ ${verify} == 'true' ]]; then
  [[ -f ${target_path} ]] || die "missing snippet: ${target_path}"
  [[ -s ${target_path} ]] || die "empty snippet: ${target_path}"
  if ! command -v python3 >/dev/null 2>&1; then
    die 'python3 is required for verify'
  fi
  if ! python3 - "${target_path}" <<'PY'
import pathlib
import sys

try:
    import yaml
except Exception as exc:
    print(f'error: PyYAML is required for verify: {exc}', file=sys.stderr)
    raise SystemExit(1)

path = pathlib.Path(sys.argv[1])
try:
    payload = path.read_text(encoding='utf-8')
except OSError as exc:
    print(f'error: unable to read {path}: {exc}', file=sys.stderr)
    raise SystemExit(1)

try:
    yaml.safe_load(payload)
except yaml.YAMLError as exc:
    print(f'error: invalid YAML in {path}: {exc}', file=sys.stderr)
    raise SystemExit(1)
PY
  then
    exit 1
  fi
  exit 0
fi

tmp_file=''
trap '[[ -z ${tmp_file} ]] || "${RM}" -f "${tmp_file}"' EXIT
tmp_file="$(${MKTEMP} /tmp/astra-pve-snippet-upload.XXXXXX)"

cat >"${tmp_file}"

${MKDIR} -p "${target_dir}"
install_mode='0600'
if command -v findmnt >/dev/null 2>&1; then
  fstype="$(findmnt -no FSTYPE --target "${storage_dir}" 2>/dev/null || true)"
  case ${fstype} in
    nfs|nfs4)
      install_mode='0644'
      ;;
  esac
elif [[ ${storage_dir} == /mnt/pve/* ]]; then
  install_mode='0644'
fi

# Snippets may live on shared NFS storage with root-squash enabled. Do not force
# root ownership here; let the storage backend assign the owner while this
# wrapper constrains the destination path and mode.
${INSTALL} -m "${install_mode}" "${tmp_file}" "${target_path}"
