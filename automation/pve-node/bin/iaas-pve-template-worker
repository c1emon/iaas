#!/usr/bin/env python3
"""Fixed worker used only by the iaas-pve-template systemd service."""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import tempfile
import re
import time
import uuid
from typing import Any
from urllib.parse import urlparse
from urllib.request import Request, urlopen


LOCK = Path(os.environ.get("IAAS_PVE_TEMPLATE_LOCK", "/run/lock/iaas-pve-template-build.lock"))
LOCK_TIMEOUT = float(os.environ.get("IAAS_PVE_TEMPLATE_LOCK_TIMEOUT", "30"))
QM = os.environ.get("IAAS_PVE_QM", "/usr/sbin/qm")
VIRT_CUSTOMIZE = os.environ.get("IAAS_PVE_VIRT_CUSTOMIZE", "/usr/bin/virt-customize")
VIRT_SYSPREP = os.environ.get("IAAS_PVE_VIRT_SYSPREP", "/usr/bin/virt-sysprep")
PVESH = os.environ.get("IAAS_PVE_PVESH", "/usr/sbin/pvesh")
IP = os.environ.get("IAAS_PVE_IP", "/usr/sbin/ip")
MIN_FREE_BYTES = int(os.environ.get("IAAS_PVE_MIN_FREE_BYTES", "1073741824"))
VM_PHASES = {"create", "import", "configure", "template"}


def valid_volume_id(value: Any) -> bool:
    """Accept storage-qualified IDs, including directory-backed image names."""
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9_.:/-]+", value):
        return False
    volume = value.partition(":")[2]
    return all(part not in {"", ".", ".."} for part in volume.split("/"))


def check_local_space(directory: Path, minimum: int) -> None:
    """Check a minimum image budget for cache and work on their real filesystems."""
    if minimum <= 0:
        raise RuntimeError("minimum free space must be positive")
    budgets: dict[int, tuple[Path, int]] = {}
    for name in ("cache", "work"):
        path = directory / name
        while not path.exists():
            path = path.parent
        device = path.stat().st_dev
        previous = budgets.get(device, (path, 0))
        budgets[device] = (path, previous[1] + minimum)
    for path, required in budgets.values():
        if shutil.disk_usage(path).free < required:
            raise RuntimeError("local cache/work free space is insufficient")


def check_storage_row(row: dict[str, Any], minimum: int) -> int:
    content = row.get("content")
    if not isinstance(content, str) or "images" not in content.split(","):
        raise RuntimeError("required storage does not support images")
    if any(type(row.get(key)) not in (int, bool) or row[key] != 1 for key in ("enabled", "active")):
        raise RuntimeError("required storage enabled/active status is unavailable")
    try:
        available = int(row["avail"])
    except (KeyError, TypeError, ValueError):
        raise RuntimeError("required storage free space is unknown") from None
    if minimum <= 0 or available < minimum:
        raise RuntimeError("required storage free space is insufficient")
    return available


def atomic(path: Path, value: dict[str, Any]) -> None:
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, indent=2)
            handle.write("\n")
        os.chmod(name, 0o600)
        os.replace(name, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(name)


def acquire_lock(path: Path):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = path.open("a+")
    deadline = time.monotonic() + LOCK_TIMEOUT
    while True:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            if time.monotonic() >= deadline:
                handle.close()
                raise TimeoutError("template node lock wait exceeded bound") from None
            time.sleep(0.1)


def require_local_node(node: Any) -> None:
    local = socket.gethostname().split(".", 1)[0]
    if not isinstance(node, str) or node != local:
        raise RuntimeError("template target node does not match this PVE node")


def refresh_effects(record: dict[str, Any]) -> None:
    storage = record.get("storage_effects", {})
    vm = record.get("vm_effects", "none")
    values = [storage.get("cache", "none"), storage.get("work", "none"), vm]
    if "unknown" in values:
        record["effects"] = "unknown"
    elif all(value == "none" for value in values):
        record["effects"] = "none"
    else:
        record["effects"] = "known"


def set_effect(record: dict[str, Any], name: str, value: str, directory: Path) -> None:
    if name == "vm":
        record["vm_effects"] = value
    else:
        record.setdefault("storage_effects", {})[name] = value
    refresh_effects(record)
    atomic(directory / "record.json", record)


def observe_object(vmid: str, record: dict[str, Any], directory: Path) -> dict[str, Any]:
    """Read the native identity after conversion; never infer it from VMID."""
    result = subprocess.run([QM, "config", vmid], capture_output=True, text=True, check=False)
    logs = directory / "logs"
    logs.mkdir(mode=0o700, exist_ok=True)
    (logs / "verify.log").write_text((result.stdout or "") + (result.stderr or ""), encoding="utf-8")
    os.chmod(logs / "verify.log", 0o600)
    if result.returncode != 0:
        raise RuntimeError("template configuration could not be observed")
    disks: dict[str, str] = {}
    smbios_uuid = None
    configuration: dict[str, str] = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition(":")
        if not separator:
            continue
        key, value = key.strip(), value.strip()
        configuration[key] = value
        if re.fullmatch(r"(?:scsi|virtio|sata|ide)\d+", key) and "media=cdrom" not in value:
            disks[key] = value.split(",", 1)[0]
        match = re.search(r"(?:^|,)uuid=([0-9a-fA-F-]{36})(?:,|$)", value)
        if key == "smbios1" and match:
            smbios_uuid = match.group(1).lower()
    if not smbios_uuid:
        raise RuntimeError("template SMBIOS UUID could not be observed")
    if configuration.get("template") not in {"1", "true", "yes"}:
        raise RuntimeError("current object is not a template")
    return {"node": record.get("node"), "vmid": int(vmid), "smbios_uuid": smbios_uuid,
            "disks": disks, "configuration": configuration, "template": True}


def imported_volume(vmid: str, directory: Path) -> str:
    result = subprocess.run([QM, "config", vmid], capture_output=True, text=True, check=False)
    logs = directory / "logs"
    logs.mkdir(mode=0o700, exist_ok=True)
    (logs / "import-observation.log").write_text((result.stdout or "") + (result.stderr or ""), encoding="utf-8")
    os.chmod(logs / "import-observation.log", 0o600)
    if result.returncode != 0:
        raise RuntimeError("imported volume could not be observed")
    for line in result.stdout.splitlines():
        if line.startswith("unused0:"):
            value = line.partition(":")[2].strip().split(",", 1)[0]
            if valid_volume_id(value):
                return value
    raise RuntimeError("imported volume was not reported as unused0")


def command(argv: list[str], *, phase: str, record: dict[str, Any], directory: Path) -> None:
    if phase in VM_PHASES:
        set_effect(record, "vm", "unknown", directory)
    record["phases"].append({"phase": phase, "status": "running"})
    atomic(directory / "record.json", record)
    result = subprocess.run(argv, cwd=directory, capture_output=True, text=True, check=False)
    logs = directory / "logs"
    logs.mkdir(mode=0o700, exist_ok=True)
    (logs / f"{phase}.log").write_text((result.stdout or "") + (result.stderr or ""), encoding="utf-8")
    os.chmod(logs / f"{phase}.log", 0o600)
    if result.returncode != 0:
        record["state"] = "failed"
        record["effects"] = "unknown"
        record["phases"][-1] = {"phase": phase, "status": "failed", "exit_code": result.returncode}
        atomic(directory / "record.json", record)
        raise RuntimeError(phase)
    record["phases"][-1] = {"phase": phase, "status": "complete", "exit_code": 0}
    if phase in VM_PHASES:
        set_effect(record, "vm", "known", directory)
    atomic(directory / "record.json", record)


def _json_command(argv: list[str], *, phase: str, record: dict[str, Any], directory: Path) -> Any:
    """Run a fixed read-only probe and fail closed on unavailable/malformed output."""
    result = subprocess.run(argv, capture_output=True, text=True, check=False)
    logs = directory / "logs"
    logs.mkdir(mode=0o700, exist_ok=True)
    (logs / f"{phase}.log").write_text((result.stdout or "") + (result.stderr or ""), encoding="utf-8")
    os.chmod(logs / f"{phase}.log", 0o600)
    if result.returncode != 0:
        raise RuntimeError(f"{phase} probe failed")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        raise RuntimeError(f"{phase} probe returned invalid JSON") from None


def prerequisites(directory: Path, request: dict[str, Any], record: dict[str, Any]) -> None:
    fixed = request["preview"]["fixed_input"]
    require_local_node(fixed["target"].get("node"))
    phase = {"phase": "prerequisites", "status": "running"}
    record["phases"].append(phase)
    atomic(directory / "record.json", record)
    try:
        node = fixed["target"]["node"]
        listing = _json_command([PVESH, "get", "/cluster/resources", "--type", "vm",
                                "--output-format", "json"],
                                phase="prerequisites-qm",
                                record=record, directory=directory)
        if isinstance(listing, dict):
            listing = listing.get("data")
        if not isinstance(listing, list):
            raise RuntimeError("cluster VM result is not a list")
        vmid = int(fixed["vmid"])
        occupied = any(isinstance(item, dict) and int(item.get("vmid", -1)) == vmid for item in listing)
        if occupied:
            raise RuntimeError("template VMID is occupied")
        storage_rows: dict[str, Any] = {}
        for storage in (fixed["import_storage"], fixed["disk_storage"]):
            rows = _json_command([PVESH, "get", f"/nodes/{node}/storage", "--output-format", "json"],
                                 phase=f"prerequisites-storage-{storage}", record=record, directory=directory)
            if isinstance(rows, dict):
                rows = rows.get("data")
            if not isinstance(rows, list):
                raise RuntimeError("storage status result is not a list")
            selected = next((row for row in rows if isinstance(row, dict) and row.get("storage") == storage), None)
            if selected is None:
                raise RuntimeError(f"storage {storage} is unavailable")
            available = check_storage_row(selected, MIN_FREE_BYTES)
            storage_rows[storage] = {"avail": available}
        check_local_space(directory, MIN_FREE_BYTES)
        bridge = subprocess.run([IP, "link", "show", fixed["build_bridge"]], capture_output=True,
                                text=True, check=False)
        (directory / "logs" / "prerequisites-bridge.log").write_text(
            (bridge.stdout or "") + (bridge.stderr or ""), encoding="utf-8")
        os.chmod(directory / "logs" / "prerequisites-bridge.log", 0o600)
        if bridge.returncode != 0:
            raise RuntimeError("build bridge is unavailable")
        phase.update(status="complete", vmid_status="free", storage=storage_rows,
                     bridge=fixed["build_bridge"])
    except Exception:
        phase["status"] = "failed"
        atomic(directory / "record.json", record)
        raise
def build(directory: Path, request: dict[str, Any], record: dict[str, Any]) -> None:
    preview = request["preview"]["fixed_input"]
    vmid = str(preview["vmid"])
    name = preview["version"]
    image = preview["image_url"]
    # The URL is fixed by the preview and no shell is involved in its use.
    parsed = urlparse(image)
    if parsed.scheme not in {"https"} or not parsed.netloc:
        raise RuntimeError("image URL must be HTTPS")
    if not parsed.path or Path(parsed.path).name in {"", ".", ".."}:
        raise RuntimeError("image URL must name an image")
    cache = directory / "cache"
    work = directory / "work"
    cache.mkdir(mode=0o700, exist_ok=True)
    work.mkdir(mode=0o700, exist_ok=True)
    source = cache / Path(parsed.path).name
    custom = work / f"{name}.qcow2"
    smbios_uuid = str(uuid.uuid4())
    record["planned_object"] = {"node": preview["target"]["node"], "vmid": int(vmid),
                                 "smbios_uuid": smbios_uuid}
    atomic(directory / "record.json", record)
    if not source.exists():
        set_effect(record, "cache", "unknown", directory)
        record["phases"].append({"phase": "download", "status": "running"})
        atomic(directory / "record.json", record)
        request_obj = Request(image, headers={"Accept": "application/octet-stream"})
        with urlopen(request_obj, timeout=120) as response, source.open("wb") as output:
            shutil.copyfileobj(response, output)
        set_effect(record, "cache", "known", directory)
        record["phases"][-1] = {"phase": "download", "status": "complete", "cache": str(source)}
        atomic(directory / "record.json", record)
    else:
        set_effect(record, "cache", "known", directory)
        record["phases"].append({"phase": "cache", "status": "reused", "cache": str(source)})
        atomic(directory / "record.json", record)
    record["phases"].append({"phase": "checksum", "status": "running"})
    atomic(directory / "record.json", record)
    digest = hashlib.sha512(source.read_bytes()).hexdigest()
    if digest != preview["image_sha512"].lower():
        record["phases"][-1] = {"phase": "checksum", "status": "failed"}
        atomic(directory / "record.json", record)
        raise RuntimeError("image checksum mismatch")
    record["phases"][-1] = {"phase": "checksum", "status": "complete"}
    atomic(directory / "record.json", record)
    set_effect(record, "work", "unknown", directory)
    shutil.copyfile(source, custom)
    sources = work / "debian.sources"
    sources.write_text(
        "Types: deb\n"
        f"URIs: {preview['apt_mirror']}\n"
        "Suites: trixie trixie-updates\n"
        "Components: main\n"
        "Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\n"
        "Types: deb\n"
        f"URIs: {preview['apt_security_mirror']}\n"
        "Suites: trixie-security\n"
        "Components: main\n"
        "Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg\n",
        encoding="utf-8",
    )
    set_effect(record, "work", "known", directory)
    command([VIRT_CUSTOMIZE, "-a", str(custom), "--install",
             "cloud-init,qemu-guest-agent,openssh-server", "--upload", f"{sources}:/etc/apt/sources.list.d/debian.sources",
             "--run-command", "rm -f /etc/apt/sources.list", "--run-command", "apt-get update",
             "--run-command", "cloud-init clean --logs", "--timezone", preview["timezone"],
             "--run-command", f"locale-gen {preview['locale']}"],
            phase="customize", record=record, directory=directory)
    command([VIRT_SYSPREP, "-a", str(custom), "--operations",
             "machine-id,ssh-hostkeys,logfiles,tmp-files,package-manager-cache"],
            phase="sysprep", record=record, directory=directory)
    command([QM, "create", vmid, "--name", name, "--memory", "2048", "--cores", "2",
             "--cpu", "host", "--ostype", "l26", "--machine", "q35", "--bios", "ovmf",
             "--scsihw", "virtio-scsi-single", "--smbios1", f"uuid={smbios_uuid}",
             "--efidisk0", f"{preview['disk_storage']}:0,efitype=4m,format=raw",
             "--net0", f"virtio,bridge={preview['build_bridge']}"],
            phase="create", record=record, directory=directory)
    command([QM, "importdisk", vmid, str(custom), preview["disk_storage"], "--format", "qcow2"],
            phase="import", record=record, directory=directory)
    record["phases"].append({"phase": "import-observation", "status": "running"})
    atomic(directory / "record.json", record)
    imported = imported_volume(vmid, directory)
    record["phases"][-1] = {"phase": "import-observation", "status": "complete", "volume": imported}
    atomic(directory / "record.json", record)
    command([QM, "set", vmid, "--scsi0", imported, "--ide2",
             f"{preview['import_storage']}:cloudinit",
             "--boot", "order=scsi0", "--agent", "enabled=1", "--ciuser", preview["ciuser"],
             "--searchdomain", preview["build_domain"], "--nameserver", preview["nameserver"]],
            phase="configure", record=record, directory=directory)
    command([QM, "template", vmid], phase="template", record=record, directory=directory)
    observed = observe_object(vmid, record, directory)
    observed["node"] = preview["target"]["node"]
    template_record = {"schema_version": 1, "record_id": f"template-{record['execution_id']}",
                       "target": record["target"], "object": observed,
                       "configuration": observed["configuration"],
                       "verification": {"status": "passed", "scope": "native-template-config"}}
    atomic(directory / "template-record.json", {"records": [template_record]})
    record["phases"].append({"phase": "cleanup-work", "status": "running"})
    atomic(directory / "record.json", record)
    set_effect(record, "work", "unknown", directory)
    custom.unlink()
    sources.unlink()
    set_effect(record, "work", "cleaned", directory)
    record["phases"][-1] = {"phase": "cleanup-work", "status": "complete"}
    atomic(directory / "record.json", record)
    record.update(state="succeeded", vm_effects="known", objects=[observed], object=observed,
                  template_record=template_record)
    refresh_effects(record)
    atomic(directory / "record.json", record)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--execution-dir", required=True)
    args = parser.parse_args()
    directory = Path(args.execution_dir)
    request = json.loads((directory / "request.json").read_text(encoding="utf-8"))
    record = json.loads((directory / "record.json").read_text(encoding="utf-8"))
    record.setdefault("storage_effects", {"cache": "none", "work": "none"})
    record.setdefault("vm_effects", "none")
    refresh_effects(record)
    handle = None
    try:
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        handle = acquire_lock(LOCK)
        record["state"] = "running"
        record["phases"].append({"phase": "lock", "status": "acquired"})
        atomic(directory / "record.json", record)
        prerequisites(directory, request, record)
        build(directory, request, record)
        atomic(directory / "receipt.json", {
            "schema_version": 1, "kind": "pve-template-receipt",
            "execution_id": record["execution_id"],
            "preview_digest": record.get("preview_digest"),
            "status": "succeeded", "effects": record.get("effects", "unknown"),
            "storage_effects": record.get("storage_effects"),
            "vm_effects": record.get("vm_effects"),
            "phases": record.get("phases", []), "recovery_of": record.get("recovery_of"),
            "target": record.get("target"), "object": record.get("object"),
            "template_record": record.get("template_record"),
            "publication": "caller_owned", "clone_verification": "not_performed",
            "business_acceptance": "not_performed",
        })
    except Exception:
        record["state"] = "failed"
        refresh_effects(record)
        atomic(directory / "record.json", record)
        atomic(directory / "receipt.json", {
            "schema_version": 1, "kind": "pve-template-receipt",
            "execution_id": record.get("execution_id"),
            "preview_digest": record.get("preview_digest"), "status": "failed",
            "effects": record.get("effects", "unknown"),
            "storage_effects": record.get("storage_effects"),
            "vm_effects": record.get("vm_effects"), "phases": record.get("phases", []),
            "recovery_of": record.get("recovery_of"), "publication": "caller_owned",
            "clone_verification": "not_performed", "business_acceptance": "not_performed",
        })
        return 1
    finally:
        if handle is not None:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
            handle.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
