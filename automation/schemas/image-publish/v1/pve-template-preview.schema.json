{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaas.invalid/schemas/image-publish/v1/pve-template-preview.schema.json",
  "title": "pve-template-preview/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "action", "fixed_input", "runtime", "observed", "preview_digest"],
  "properties": {
    "kind": {"const": "pve-template-preview"},
    "schema_version": {"const": 2},
    "action": {"enum": ["publish", "cleanup", "retire"]},
    "fixed_input": {"type": "object"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "disk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["image_digest"],
      "properties": {"image_digest": {"type": "string", "pattern": "^([^@/\\s]+(/[^@\\s]+)*)?@?sha256:[0-9a-f]{64}$"}}
    },
    "requirements": {"type": "object"},
    "observed": {"type": "object"},
    "preview_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "publish"}}},
      "then": {
        "required": ["artifact_digest", "disk_sha256", "requirements"],
        "properties": {"fixed_input": {"$ref": "pve-template-publish-request.schema.json"}}
      }
    },
    {
      "if": {"properties": {"action": {"const": "cleanup"}}},
      "then": {"properties": {"fixed_input": {"$ref": "#/$defs/cleanup_request"}}}
    },
    {
      "if": {"properties": {"action": {"const": "retire"}}},
      "then": {"properties": {"fixed_input": {"$ref": "#/$defs/retire_request"}}}
    }
  ],
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false, "required": ["api_endpoint", "node", "tls_verify"],
      "properties": {
        "api_endpoint": {"type": "string", "pattern": "^https://[^/?#]+$"},
        "node": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "tls_verify": {"const": true}
      }
    },
    "ownership": {"type": "object", "additionalProperties": false, "required": ["owner", "reference"],
      "properties": {"owner": {"const": "publisher"}, "reference": {"type": "string", "minLength": 1}}},
    "cleanup_request": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "target", "original_execution_id", "original_execution_dir", "original_preview_digest", "objects", "volumes", "ownership_admission"],
      "properties": {
        "kind": {"const": "pve-template-cleanup-request"}, "schema_version": {"const": 1},
        "target": {"$ref": "#/$defs/target"}, "original_execution_id": {"type": "string", "minLength": 1},
        "original_execution_dir": {"type": "string", "minLength": 1}, "original_preview_digest": {"type": "string", "minLength": 1},
        "objects": {"type": "array"}, "volumes": {"type": "array"}, "ownership_admission": {"$ref": "#/$defs/ownership"}
      }
    },
    "retire_request": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "target", "template_record", "ownership_admission", "retirement_admission"],
      "properties": {
        "kind": {"const": "pve-template-retire-request"}, "schema_version": {"const": 1},
        "target": {"$ref": "#/$defs/target"}, "template_record": {"$ref": "pve-template-record.schema.json"},
        "ownership_admission": {"$ref": "#/$defs/ownership"},
        "retirement_admission": {"type": "object", "required": ["authorized", "dependencies_resolved", "reference"],
          "properties": {"authorized": {"const": true}, "dependencies_resolved": {"const": true}, "reference": {"type": "string", "minLength": 1}}}
      }
    }
  }
}
