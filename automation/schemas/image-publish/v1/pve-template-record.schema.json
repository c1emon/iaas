{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaas.invalid/schemas/image-publish/v1/pve-template-record.schema.json",
  "title": "pve-template-record/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "record_id", "target", "node", "vmid", "smbios_uuid", "volumes", "configuration", "origin", "execution_id", "artifact_digest", "verification"],
  "properties": {
    "kind": {"const": "pve-template-record"}, "schema_version": {"const": 2},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "target": {"type": "object", "additionalProperties": false, "required": ["api_endpoint", "node", "tls_verify"], "properties": {"api_endpoint": {"type": "string", "pattern": "^https://[^/?#]+$"}, "node": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}, "tls_verify": {"const": true}}},
    "node": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}, "vmid": {"type": "integer", "minimum": 1}, "smbios_uuid": {"type": "string", "minLength": 1},
    "volumes": {"type": "object", "minProperties": 1}, "configuration": {"type": "object"}, "origin": {"enum": ["publication", "observation"]},
    "execution_id": {"type": "string", "minLength": 1}, "artifact_digest": {"type": "string", "minLength": 1},
    "verification": {"type": "object", "required": ["template_config"], "properties": {"template_config": {"const": "passed"}, "guest_acceptance": {"type": "string"}, "caller_promotion": {"type": "string"}}}
  }
}
