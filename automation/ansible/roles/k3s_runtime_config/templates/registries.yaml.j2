---
mirrors:
{% for mirror in k3s_runtime_model.cluster.registry.mirrors %}
  {{ mirror.registry | to_json }}:
    endpoint:
      - {{ mirror.endpoint | to_json }}
{% if mirror.rewrites | length > 0 %}
    rewrite:
{% for pattern, replacement in mirror.rewrites.items() %}
      {{ pattern | to_json }}: {{ replacement | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
{% if k3s_runtime_model.cluster.registry.mirrors | length > 0 %}
configs:
{% set rendered = namespace(endpoints=[]) %}
{% for mirror in k3s_runtime_model.cluster.registry.mirrors %}
{% set authority = mirror.endpoint | urlsplit('netloc') | lower %}
{% if authority not in rendered.endpoints %}
{% set rendered.endpoints = rendered.endpoints + [authority] %}
  {{ authority | to_json }}:
{% if mirror.auth_ref is defined and mirror.auth_ref %}
{% set auth = lookup('k3s_protected_secret', mirror.auth_ref, secret_file=k3s_runtime_secret_file) | from_json %}
    auth:
      username: {{ auth.username | to_json }}
      password: {{ auth.password | to_json }}
{% endif %}
{% if (mirror.ca_ref is defined and mirror.ca_ref) or (mirror.client_cert_ref is defined and mirror.client_cert_ref) %}
    tls:
{% if mirror.ca_ref is defined and mirror.ca_ref %}
      ca_file: {{ lookup('k3s_protected_secret', mirror.ca_ref, secret_file=k3s_runtime_secret_file) | to_json }}
{% endif %}
{% if mirror.client_cert_ref is defined and mirror.client_cert_ref %}
      cert_file: {{ lookup('k3s_protected_secret', mirror.client_cert_ref, secret_file=k3s_runtime_secret_file) | to_json }}
      key_file: {{ lookup('k3s_protected_secret', mirror.client_key_ref, secret_file=k3s_runtime_secret_file) | to_json }}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
