# Managed by k3s_runtime_config. Do not edit on the node.
{% set proxy = k3s_runtime_model.cluster.service_proxy %}
{% if proxy.state == 'present' %}
{% if proxy.credential_ref is defined and proxy.credential_ref %}
{% set credentials = lookup('k3s_protected_secret', proxy.credential_ref, secret_file=k3s_runtime_secret_file) | from_json %}
HTTP_PROXY={{ ('http://' ~ credentials.username ~ ':' ~ credentials.password ~ '@' ~ (proxy.url | regex_replace('^[^:]+://', ''))) | to_json }}
HTTPS_PROXY={{ ('http://' ~ credentials.username ~ ':' ~ credentials.password ~ '@' ~ (proxy.url | regex_replace('^[^:]+://', ''))) | to_json }}
{% else %}
HTTP_PROXY={{ proxy.url | to_json }}
HTTPS_PROXY={{ proxy.url | to_json }}
{% endif %}
NO_PROXY={{ (proxy.no_proxy | join(',')) | to_json }}
{% else %}
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY={{ (proxy.no_proxy | join(',')) | to_json }}
{% endif %}
